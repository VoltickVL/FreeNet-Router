# Локальные несекретные настройки FreeNet.
# Устанавливается в /opt/etc/freenet/freenet.conf.
# URL подписки хранится отдельно и в этот файл не записывается.

UI_PORT=1001
SETUP_COMPLETE=no
ISP_ID=auto
# Пользовательские режимы: `DNS через роутер` = firmware;
# `Раздельный DNS` = xkeen. Технические названия core в UI не показываются.
DNS_MODE=firmware

# AUTO VPN: endpoint-only по умолчанию. Режим best включается только явным
# выбором пользователя и применяет только полностью подтверждённый Eligible Extra.
AUTO_VPN_V1=no
AUTO_VPN_V1_INTERVAL=manual
AUTO_VPN_MODE=endpoint
AUTO_VPN_POLICY=degraded
AUTO_VPN_COUNTRY_SCOPE=region
AUTO_VPN_COUNTRIES=
AUTO_VPN_AUTO_APPLY=yes
# Legacy mirror для старых finalize/install контрактов: активен только когда
# endpoint-only AUTO VPN включён с реальным расписанием. Вручную => no.
AUTO_ENDPOINT_UPDATE=no
AUTO_ENDPOINT_CRON='0 * * * *'

# Failover — отдельная automatic mutation policy. Для существующих конфигураций
# отсутствие этих ключей трактуется как disabled и никогда не включает failover молча.
AUTO_VPN_FAILOVER=no
AUTO_VPN_FAILOVER_CRON='*/5 * * * *'
AUTO_XKEEN_GEODATA=yes
AUTO_XKEEN_GEODATA_CRON='30 6 * * *'
