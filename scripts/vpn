#!/bin/sh

FILTER_FILE="${FREENET_FILTER_FILE:-/opt/etc/xray/blanc_profile_filter.regex}"
UPDATER_BIN="${FREENET_UPDATER_BIN:-/opt/bin/blanc_xkeen_update_outbounds.sh}"
SUB_FILE="${FREENET_SUB_FILE:-/opt/etc/xray/blanc_subscription.url}"
CURL_BIN="${FREENET_CURL_BIN:-curl}"
PIDOF_BIN="${FREENET_PIDOF_BIN:-pidof}"
XRAY_BIN="${FREENET_XRAY_BIN:-/opt/sbin/xray}"
ASSET_DIR="${FREENET_ASSET_DIR:-/opt/etc/xray/dat}"
FAILOVER_PROBES="${FREENET_FAILOVER_PROBES:-3}"
FAILOVER_DELAY_SEC="${FREENET_FAILOVER_DELAY_SEC:-2}"
FAILOVER_CONNECT_TIMEOUT="${FREENET_FAILOVER_CONNECT_TIMEOUT:-3}"
FAILOVER_MAX_TIME="${FREENET_FAILOVER_MAX_TIME:-5}"
FAILOVER_COOLDOWN_SEC="${FREENET_FAILOVER_COOLDOWN_SEC:-600}"
FAILOVER_STATE_FILE="${FREENET_FAILOVER_STATE_FILE:-/tmp/freenet-vpn-failover.last}"

if [ -n "${FREENET_CONFIG_DIR:-}" ]; then
CONFIG_DIR="$FREENET_CONFIG_DIR"
elif [ -d "/opt/etc/xray/configs" ]; then
CONFIG_DIR="/opt/etc/xray/configs"
elif [ -d "/opkg/etc/xray/configs" ]; then
CONFIG_DIR="/opkg/etc/xray/configs"
else
CONFIG_DIR="/opt/etc/xray/configs"
fi

OUT_FILE="$CONFIG_DIR/04_outbounds.json"

escape_ere() {
    awk '
        BEGIN { ORS="" }
        {
            for (i = 1; i <= length($0); i++) {
                c = substr($0, i, 1)
                if (c ~ /[][(){}.^$*+?|\\]/) printf "\\%s", c
                else printf "%s", c
            }
        }
    '
}

read_current_endpoint() {
    CURRENT_ADDRESS="$(jq -r '.outbounds[] | select(.tag == "vless-reality") | .settings.vnext[0].address // empty' "$OUT_FILE" 2>/dev/null | head -n 1)"
    CURRENT_PORT="$(jq -r '.outbounds[] | select(.tag == "vless-reality") | .settings.vnext[0].port // empty' "$OUT_FILE" 2>/dev/null | head -n 1)"
    [ -n "$CURRENT_ADDRESS" ] && [ -n "$CURRENT_PORT" ]
}

valid_positive_int() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -gt 0 ] 2>/dev/null
}

valid_nonnegative_int() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    return 0
}

tcp_probe() {
    PROBE_ADDRESS="$1"
    PROBE_PORT="$2"
    PROBE_LOG="/tmp/freenet-vpn-probe.$$.log"
    case "$PROBE_ADDRESS" in
        *:*) PROBE_HOST="[$PROBE_ADDRESS]" ;;
        *) PROBE_HOST="$PROBE_ADDRESS" ;;
    esac

    rm -f "$PROBE_LOG" 2>/dev/null || true
    "$CURL_BIN" --noproxy '*' -k -v -sS \
        --connect-timeout "$FAILOVER_CONNECT_TIMEOUT" \
        --max-time "$FAILOVER_MAX_TIME" \
        -o /dev/null \
        "https://$PROBE_HOST:$PROBE_PORT/" \
        >/dev/null 2> "$PROBE_LOG" || true

    if grep -F 'Connected to ' "$PROBE_LOG" >/dev/null 2>&1; then
        rm -f "$PROBE_LOG" 2>/dev/null || true
        return 0
    fi
    rm -f "$PROBE_LOG" 2>/dev/null || true
    return 1
}

failover_baseline_valid() {
    [ -s "$OUT_FILE" ] || {
        echo "[vpn] failover suppressed: current outbound is missing" >&2
        return 1
    }
    [ -x "$XRAY_BIN" ] || {
        echo "[vpn] failover suppressed: Xray binary is missing" >&2
        return 1
    }
    [ -d "$ASSET_DIR" ] || {
        echo "[vpn] failover suppressed: Xray asset directory is missing" >&2
        return 1
    }
    command -v "$PIDOF_BIN" >/dev/null 2>&1 || [ -x "$PIDOF_BIN" ] || {
        echo "[vpn] failover suppressed: pidof tool is missing" >&2
        return 1
    }
    "$PIDOF_BIN" xray >/dev/null 2>&1 || {
        echo "[vpn] failover suppressed: local Xray is offline" >&2
        return 1
    }
    jq -e '
        ((.outbounds | type) == "array") and
        (([.outbounds[] | select(.tag == "vless-reality")] | length) == 1) and
        (([.outbounds[] | select(.tag == "dns-out")] | length) == 1)
    ' "$OUT_FILE" >/dev/null 2>&1 || {
        echo "[vpn] failover suppressed: local Xray outbound baseline is invalid" >&2
        return 1
    }
    XRAY_LOCATION_ASSET="$ASSET_DIR" "$XRAY_BIN" run -test -confdir "$CONFIG_DIR" >/dev/null 2>&1 || {
        echo "[vpn] failover suppressed: live Xray configuration is invalid" >&2
        return 1
    }
    read_current_endpoint || {
        echo "[vpn] failover suppressed: current vless-reality endpoint is unavailable" >&2
        return 1
    }
    return 0
}

cooldown_active() {
    valid_nonnegative_int "$FAILOVER_COOLDOWN_SEC" || return 1
    [ "$FAILOVER_COOLDOWN_SEC" -gt 0 ] 2>/dev/null || return 1
    [ -s "$FAILOVER_STATE_FILE" ] || return 1
    LAST_FAILOVER="$(tr -d '[:space:]' < "$FAILOVER_STATE_FILE" 2>/dev/null)"
    case "$LAST_FAILOVER" in
        ''|*[!0-9]*) return 1 ;;
    esac
    NOW="$(date +%s 2>/dev/null)"
    case "$NOW" in
        ''|*[!0-9]*) return 1 ;;
    esac
    AGE=$((NOW - LAST_FAILOVER))
    [ "$AGE" -ge 0 ] 2>/dev/null && [ "$AGE" -lt "$FAILOVER_COOLDOWN_SEC" ] 2>/dev/null
}

mark_failover() {
    NOW="$(date +%s 2>/dev/null)"
    case "$NOW" in
        ''|*[!0-9]*) return 0 ;;
    esac
    printf '%s\n' "$NOW" > "$FAILOVER_STATE_FILE.tmp.$$" 2>/dev/null || return 0
    mv -f "$FAILOVER_STATE_FILE.tmp.$$" "$FAILOVER_STATE_FILE" 2>/dev/null || true
}

rotate_current_endpoint() {
    ROTATE_MODE="${1:-rotate}"
    case "$ROTATE_MODE" in rotate|failover) ;; *) return 2 ;; esac

    [ -x "$UPDATER_BIN" ] || {
        echo "[vpn] updater not found: $UPDATER_BIN" >&2
        return 1
    }
    [ -s "$FILTER_FILE" ] || {
        echo "[vpn] current profile filter is missing" >&2
        return 1
    }
    [ -s "$SUB_FILE" ] || {
        echo "[vpn] subscription file is missing" >&2
        return 1
    }
    [ -s "$OUT_FILE" ] || {
        echo "[vpn] current outbound is missing" >&2
        return 1
    }
    for tool in jq base64 mktemp grep sed awk cut tr cp; do
        command -v "$tool" >/dev/null 2>&1 || {
            echo "[vpn] required tool not found: $tool" >&2
            return 1
        }
    done
    command -v "$CURL_BIN" >/dev/null 2>&1 || [ -x "$CURL_BIN" ] || {
        echo "[vpn] curl tool not found: $CURL_BIN" >&2
        return 1
    }

    ROTATE_TMP="$(mktemp -d /tmp/freenet-vpn-rotate.XXXXXX 2>/dev/null)" || return 1
    [ -n "$ROTATE_TMP" ] && [ -d "$ROTATE_TMP" ] || return 1
    trap 'rm -rf "$ROTATE_TMP" 2>/dev/null' EXIT HUP INT TERM

    read_current_endpoint || {
        echo "[vpn] current vless-reality endpoint is unavailable" >&2
        return 1
    }

    SUB_URL="$(tr -d '\r\n' < "$SUB_FILE")"
    [ -n "$SUB_URL" ] || {
        echo "[vpn] subscription URL is empty" >&2
        return 1
    }

    RAW_FILE="$ROTATE_TMP/sub.raw"
    DECODED_FILE="$ROTATE_TMP/sub.decoded"
    MATCHES_FILE="$ROTATE_TMP/matches"
    ALT_FILE="$ROTATE_TMP/alternate"
    TEMP_FILTER="$ROTATE_TMP/filter.regex"

    if ! "$CURL_BIN" -4 -fsSL \
        -H 'Cache-Control: no-cache' \
        -H 'Pragma: no-cache' \
        --dns-servers '77.88.8.8,8.8.8.8' \
        --connect-timeout 20 \
        --max-time 60 \
        -A 'Mozilla/5.0' \
        "$SUB_URL" > "$RAW_FILE" 2>/dev/null; then
        echo "[vpn] rotation subscription fetch failed before mutation" >&2
        return 1
    fi

    [ -s "$RAW_FILE" ] || {
        echo "[vpn] downloaded subscription is empty" >&2
        return 1
    }

    if grep -q '^vless://' "$RAW_FILE"; then
        cp "$RAW_FILE" "$DECODED_FILE" || return 1
    else
        base64 -d "$RAW_FILE" > "$DECODED_FILE" 2>/dev/null || {
            echo "[vpn] cannot decode subscription" >&2
            return 1
        }
    fi

    CURRENT_FILTER="$(tr -d '\r\n' < "$FILTER_FILE")"
    [ -n "$CURRENT_FILTER" ] || {
        echo "[vpn] current profile filter is empty" >&2
        return 1
    }

    grep '^vless://' "$DECODED_FILE" \
        | grep -i 'Extra' \
        | grep -vi 'Expired' \
        | grep -Ei "$CURRENT_FILTER" > "$MATCHES_FILE" || true

    : > "$ALT_FILE"
    while IFS= read -r candidate; do
        [ -n "$candidate" ] || continue
        body="${candidate#vless://}"
        rest="${body#*@}"
        hostport="$(printf '%s\n' "$rest" | sed 's/[?].*$//')"
        case "$hostport" in
            *:*)
                address="${hostport%:*}"
                port="${hostport##*:}"
                ;;
            *)
                continue
                ;;
        esac
        if [ "$address" = "$CURRENT_ADDRESS" ] && [ "$port" = "$CURRENT_PORT" ]; then
            continue
        fi
        if [ "$ROTATE_MODE" = failover ] && ! tcp_probe "$address" "$port"; then
            echo "[vpn] failover candidate unreachable: $address:$port" >&2
            continue
        fi
        printf '%s\t%s\n' "$address" "$port" > "$ALT_FILE"
        break
    done < "$MATCHES_FILE"

    if [ ! -s "$ALT_FILE" ]; then
        if [ "$ROTATE_MODE" = failover ]; then
            echo "[vpn] failover unavailable: no reachable alternative endpoint in current Extra profile group" >&2
            echo "[vpn] current endpoint preserved: $CURRENT_ADDRESS:$CURRENT_PORT" >&2
            return 4
        fi
        echo "[vpn] rotation unavailable: no alternative endpoint in current Extra profile group" >&2
        echo "[vpn] current endpoint preserved: $CURRENT_ADDRESS:$CURRENT_PORT" >&2
        return 3
    fi

    ALT_ADDRESS="$(cut -f1 "$ALT_FILE")"
    ALT_PORT="$(cut -f2 "$ALT_FILE")"
    ALT_ENDPOINT="$ALT_ADDRESS:$ALT_PORT"
    printf '%s\n' "$ALT_ENDPOINT" | escape_ere > "$TEMP_FILTER"

    if [ "$ROTATE_MODE" = failover ]; then
        echo "[vpn] failover: current endpoint $CURRENT_ADDRESS:$CURRENT_PORT confirmed unreachable"
        echo "[vpn] failover: reachable alternative $ALT_ENDPOINT"
    else
        echo "[vpn] rotate: current endpoint $CURRENT_ADDRESS:$CURRENT_PORT"
        echo "[vpn] rotate: selected alternative endpoint $ALT_ENDPOINT"
    fi
    echo "[vpn] saved profile group remains unchanged"

    FREENET_FILTER_FILE="$TEMP_FILTER" \
    FREENET_ACTION_REASON="$ROTATE_MODE" \
    "$UPDATER_BIN"
    rc=$?

    rm -rf "$ROTATE_TMP" 2>/dev/null
    trap - EXIT HUP INT TERM
    return "$rc"
}

failover_current_endpoint() {
    command -v "$CURL_BIN" >/dev/null 2>&1 || [ -x "$CURL_BIN" ] || {
        echo "[vpn] failover suppressed: curl tool is missing" >&2
        return 1
    }
    valid_positive_int "$FAILOVER_PROBES" || {
        echo "[vpn] failover suppressed: invalid probe count" >&2
        return 1
    }
    valid_nonnegative_int "$FAILOVER_DELAY_SEC" || {
        echo "[vpn] failover suppressed: invalid probe delay" >&2
        return 1
    }
    valid_positive_int "$FAILOVER_CONNECT_TIMEOUT" || {
        echo "[vpn] failover suppressed: invalid connect timeout" >&2
        return 1
    }
    valid_positive_int "$FAILOVER_MAX_TIME" || {
        echo "[vpn] failover suppressed: invalid max time" >&2
        return 1
    }
    valid_nonnegative_int "$FAILOVER_COOLDOWN_SEC" || {
        echo "[vpn] failover suppressed: invalid cooldown" >&2
        return 1
    }

    failover_baseline_valid || return 2

    if cooldown_active; then
        echo "[vpn] failover suppressed by cooldown; current endpoint preserved: $CURRENT_ADDRESS:$CURRENT_PORT"
        return 0
    fi

    PROBE_INDEX=1
    while [ "$PROBE_INDEX" -le "$FAILOVER_PROBES" ]; do
        if tcp_probe "$CURRENT_ADDRESS" "$CURRENT_PORT"; then
            if [ "$PROBE_INDEX" -eq 1 ]; then
                echo "[vpn] failover check: current endpoint reachable; no mutation"
            else
                echo "[vpn] failover check: endpoint recovered on probe $PROBE_INDEX/$FAILOVER_PROBES; no mutation"
            fi
            return 0
        fi
        echo "[vpn] failover probe $PROBE_INDEX/$FAILOVER_PROBES failed for $CURRENT_ADDRESS:$CURRENT_PORT" >&2
        if [ "$PROBE_INDEX" -lt "$FAILOVER_PROBES" ] && [ "$FAILOVER_DELAY_SEC" -gt 0 ] 2>/dev/null; then
            sleep "$FAILOVER_DELAY_SEC"
        fi
        PROBE_INDEX=$((PROBE_INDEX + 1))
    done

    echo "[vpn] failover trigger: current endpoint failed all $FAILOVER_PROBES TCP probes" >&2
    rotate_current_endpoint failover
    rc=$?
    if [ "$rc" -eq 0 ]; then
        mark_failover
        echo "[vpn] failover completed transactionally"
    fi
    return "$rc"
}

case "${1:-}" in
de)
FILTER='Frankfurt|Frankfurt am Main|Germany|Deutschland|Германия|Франкфурт'
NAME="Germany / Frankfurt / Extra"
;;
pl)
FILTER='Warsaw|Warszawa|Poland|Polska|Польша|Варшава'
NAME="Poland / Warsaw / Extra"
;;
fi)
FILTER='Helsinki|Finland|Suomi|Финляндия|Хельсинки'
NAME="Finland / Helsinki / Extra"
;;
nl)
FILTER='Amsterdam|Netherlands|Nederland|Holland|Нидерланды|Голландия|Амстердам'
NAME="Netherlands / Amsterdam / Extra"
;;
current|status)
echo "===== CURRENT FILTER ====="
if [ -f "$FILTER_FILE" ]; then
cat "$FILTER_FILE"
else
echo "no filter file"
fi
echo
echo "===== CURRENT OUTBOUND ====="
if [ -f "$OUT_FILE" ]; then
grep '"address"' "$OUT_FILE" 2>/dev/null | head -n 1
grep '"port"' "$OUT_FILE" 2>/dev/null | head -n 1
else
echo "outbound file not found: $OUT_FILE"
fi
exit 0
;;
reload|update|refresh)
FREENET_ACTION_REASON=refresh "$UPDATER_BIN"
exit $?
;;
rotate)
rotate_current_endpoint rotate
exit $?
;;
failover)
failover_current_endpoint
exit $?
;;
*)
echo "Usage:"
echo "  vpn de       Germany / Frankfurt / Extra"
echo "  vpn pl       Poland / Warsaw / Extra"
echo "  vpn fi       Finland / Helsinki / Extra"
echo "  vpn nl       Netherlands / Amsterdam / Extra"
echo "  vpn current  show current filter and endpoint"
echo "  vpn status   same as current"
echo "  vpn reload   refresh current selected Extra profile"
echo "  vpn update   same as reload"
echo "  vpn refresh  same as reload"
echo "  vpn rotate   select another endpoint in current Extra profile group"
echo "  vpn failover rotate only after repeated current-endpoint failure and reachable-alternative check"
exit 1
;;
esac

[ -x "$UPDATER_BIN" ] || {
echo "[vpn] updater not found: $UPDATER_BIN" >&2
exit 1
}

echo "[vpn] requested: $NAME"
echo "[vpn] filter will be committed only after successful validation/apply"
echo

FREENET_FILTER_OVERRIDE="$FILTER" \
FREENET_PROFILE_LABEL="$NAME" \
FREENET_ACTION_REASON=switch \
"$UPDATER_BIN"
